# Copy to .env in the project root. The server loads it automatically.
# Never put any of these values into Flutter --dart-define or commit .env.
AI_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only when creating NEW local accounts. Existing passwords are preserved.
# Empty values generate strong passwords, printed ONCE in the server console.
DEMO_EMPLOYEE_PASSWORD=
DEMO_COLLEAGUE_PASSWORD=
DEMO_HR_PASSWORD=

# Optional separate demo database, preserving the default working database:
# CAREER_DB=data/local/showcase.sqlite3
# CAREER_DATA_DIR=data/sample
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
